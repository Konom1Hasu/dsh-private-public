{
  "name": "@yg/dsh-client-locale-cat",
  "version": "0.1.0",
  "private": true,
  "description": "Catgirl localization pack (zh-x-cat) for dsh Web UI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "locale/*.json"
  ],
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
